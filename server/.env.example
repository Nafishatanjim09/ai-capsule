# Copy this file to .env and fill in real values. Never commit the real .env file.

# Port the Express server listens on (most cloud platforms set this automatically)
PORT=5000

# "development" locally, "production" when deployed (controls the cookie's Secure flag)
NODE_ENV=development

# The public base URL of this app — used to build the GitHub OAuth callback URL.
# Local:      http://localhost:5000
# Deployed:   https://your-app-name.onrender.com
APP_BASE_URL=http://localhost:5000

# Long random string used to sign/verify the application JWT.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# From your GitHub OAuth App (GitHub -> Settings -> Developer settings -> OAuth Apps)
# Authorization callback URL must be: <APP_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_github_oauth_client_secret

# Path to the SQLite database file
DATABASE_PATH=./capsule.db
